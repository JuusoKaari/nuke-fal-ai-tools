  which {{parent.viewer_mode}}
  name viewer_mode_switch
  xpos 858
  ypos 1020
 }
set Nf9827200 [stack 0]
 Output {
  name Output1
  xpos 858
  ypos 1285
 }
 Input {
  inputs 0
  name prompt_text
  xpos 1052
  ypos -678
  number 2
 }
push $Nb1c82f00
push $Nf9827200
 Viewer {
  inputs 1
  frame_range 0-199
  fps 25
  input_number 0
  name Viewer1
  xpos -646
  ypos 1786
 }
end_group
