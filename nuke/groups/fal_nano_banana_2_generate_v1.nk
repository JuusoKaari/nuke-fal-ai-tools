  box_width {{format_checker_2.width}}
  box_height {{format_checker_2.height}}
  box_fixed true
  resize fit
  center false
  name reformat_to_match1
  xpos 558
  ypos 61
 }
 Input {
  inputs 0
  name image_a
  xpos 77
  ypos -667
  number 0
 }
 NoOp {
  name preview_source_01
  xpos 77
  ypos -292
 }
set N16c9200 [stack 0]
 Dot {
