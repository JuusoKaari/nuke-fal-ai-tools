  which {{parent.mark_ai_inputs}}
  name ai_mark_select_01
  xpos 324
  ypos 210
 }
set Nf9824500 [stack 0]
push $Nef487200
push $Nf9824500
 Switch {
  inputs 2
  which {{"parent.preview_index - 1"}}
  name ai_input_switch
  xpos 538
  ypos 386
 }
set Ndb7c300 [stack 0]
 Reformat {
  inputs 0
  format "2048 2048 0 0 2048 2048 1 square_2K"
  name Reformat1
  xpos -663
  ypos 153
 }
 Text {
  message "Nano Banana 2\nText-to-image or image edit.\n\nImage inputs: Connect main image to image_a and optional reference to image_b.\nPrompt: Write on the node, or connect separate Text node to prompt_text input.\nPress Execute, then use Viewer mode to preview outputs."
  font C:/Windows/Fonts/arial.ttf
  size 50
  xjustify center
  yjustify center
  Transform 1
  box {0 0 2048 2048}
  center {2304 1582}
  name Text1
  xpos -663
  ypos 191
 }
 Reformat {
  type "to box"
  box_width {{format_checker_1.width}}
  box_height {{format_checker_1.height}}
  box_fixed true
  resize fit
  name reformat_to_match
  xpos -663
  ypos 217
 }
push $Ndb7c300
 Multiply {
