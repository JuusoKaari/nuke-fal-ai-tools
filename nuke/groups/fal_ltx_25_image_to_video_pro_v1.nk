# Purpose:
# - Nuke Group node that runs fal.ai LTX 2.5 Pro image-to-video on a still (start frame), optional end frame for transitions.
# - Keeps the .nk execute script small by delegating logic to a Python runner in `nuke/python/`.
# - Model: https://fal.ai/models/lightricks/ltx-2.5/image-to-video/pro

set cut_paste_input [stack 0]
version 11.3 v6
push $cut_paste_input
Group {
 name LTX_25_Image_To_Video_Pro_v1
 selected true
 addUserKnob {20 Settings}
 addUserKnob {1 prompt l Prompt}
 prompt "Describe the motion and scene (pure generation from the start image, not an edit instruction)"
 addUserKnob {4 duration l Duration M {auto 6 8 10 ""}}
 duration auto
 addUserKnob {4 resolution l Resolution M {720p 1080p ""}}
 resolution 1080p
 addUserKnob {4 aspect_ratio l "Aspect ratio" M {auto 16:9 9:16 ""}}
 aspect_ratio auto
 addUserKnob {4 fps l FPS M {24 25 50 ""}}
 fps 25
 addUserKnob {4 camera_motion l "Camera motion" M {none dolly_in dolly_out dolly_left dolly_right jib_up jib_down static focus_shift ""}}
 camera_motion none
 addUserKnob {6 generate_audio l "Generate audio" +STARTLINE}
 generate_audio true
 addUserKnob {6 show_success_popup l "Show success popup" +STARTLINE}
 show_success_popup true
 addUserKnob {22 execute T "import _nuke_runner_launcher\n_nuke_runner_launcher.execute_this_node()\n" +STARTLINE}
 addUserKnob {20 endGroup n -1}
 addUserKnob {20 Advanced l Advanced +CLOSED}
 addUserKnob {1 python3_cmd l "Python 3 cmd"}
 python3_cmd "py -3"
 addUserKnob {1 FAL}
 FAL "insert your secret key here or use env variable FAL_KEY"
 addUserKnob {20 endAdvanced n -1}
 addUserKnob {1 helper_path l "Helper path" +INVISIBLE}
 helper_path "__INSTALL_ROOT__/nuke/python/fal_ltx_25_image_to_video_pro_helper.py"
 addUserKnob {1 runner_path l "Runner path" +INVISIBLE}
 runner_path "__INSTALL_ROOT__/nuke/python/fal_ltx_25_image_to_video_pro_runner_v1.py"
}
Text {
 inputs 0
 message "Connect start_image (required). Optionally connect end_image for a transition.\nSet prompt and options, then Execute."
 font C:/Windows/Fonts/arial.ttf
 yjustify bottom
 Transform 1
 box {30 30 1906 1052}
 center {560 372}
 name Text1
 xpos 101
 ypos 294
}
set Nltx25i2v000 [stack 0]
Output {
 name Output1
 xpos 101
 ypos 406
}
Input {
 inputs 0
 name start_image
 xpos 0
 ypos -51
}
Input {
 inputs 0
 name end_image
 xpos 188
 ypos -51
 number 1
}
push $Nltx25i2v000
Viewer {
 inputs 1
 frame_range 0-199
 fps 25
 input_number 0
 name Viewer1
 selected true
 xpos 281
 ypos 412
}
end_group
