# Purpose:
# - Nuke Group node that runs fal.ai Pika 2.2 Pikaframes keyframe interpolation (2-5 keyframe images).
# - Output1 looks through keyframe_1 (the first still). No in-group generated video preview; Execute still spawns a Read of the result.
# - Connect/execute notes live on the guide_info knob.
# - Keeps the .nk execute script small by delegating logic to a Python runner in `nuke/python/`.
# - Model: https://fal.ai/models/fal-ai/pika/v2.2/pikaframes

set cut_paste_input [stack 0]
version 11.3 v6
push $cut_paste_input
Group {
 name Pika_22_Pikaframes_v1
 selected true
 addUserKnob {20 Settings}
 addUserKnob {26 guide_info l "" T "Connect 2-5 keyframes in order (keyframe_1 .. keyframe_5).\nLeave unused inputs disconnected. Total transition time must be <= 25 sec.\nSet prompt and options, then Execute."}
 addUserKnob {1 prompt l Prompt}
 prompt "smooth cinematic transition"
 addUserKnob {1 negative_prompt l "Negative prompt"}
 negative_prompt ""
 addUserKnob {1 transition_duration l "Transition duration (sec)"}
 transition_duration "5"
 addUserKnob {4 resolution l Resolution M {720p 1080p ""}}
 resolution 720p
 addUserKnob {1 seed l "Seed (optional)"}
 seed ""
 addUserKnob {6 show_success_popup l "Show success popup" +STARTLINE}
 show_success_popup true
 addUserKnob {22 execute T "import _nuke_runner_launcher\n_nuke_runner_launcher.execute_this_node()\n" +STARTLINE}
 addUserKnob {20 endGroup n -1}
 addUserKnob {20 Advanced l Advanced +CLOSED}
 addUserKnob {1 python3_cmd l "Python 3 cmd"}
 python3_cmd "py -3"
 addUserKnob {1 FAL}
 FAL "insert fal key to override for this node"
 addUserKnob {22 open_temp_folder l "Open temp folder" T "import nuke_fal_open_folders_v1 as _of\n_of.open_temp_folder()\n" +STARTLINE}
 addUserKnob {22 open_output_folder l "Open output folder" T "import nuke_fal_open_folders_v1 as _of\n_of.open_output_folder()\n"}
 addUserKnob {20 endAdvanced n -1}
 addUserKnob {1 helper_path l "Helper path" +INVISIBLE}
 helper_path "__INSTALL_ROOT__/nuke/python/fal_pika_v22_pikaframes_helper.py"
 addUserKnob {1 runner_path l "Runner path" +INVISIBLE}
 runner_path "__INSTALL_ROOT__/nuke/python/fal_pika_v22_pikaframes_runner_v1.py"
}
Input {
 inputs 0
 name keyframe_1
 xpos 0
 ypos -51
}
set Npikaframes000 [stack 0]
Output {
 name Output1
 xpos 101
 ypos 406
}
Input {
 inputs 0
 name keyframe_2
 xpos 94
 ypos -51
 number 1
}
Input {
 inputs 0
 name keyframe_3
 xpos 188
 ypos -51
 number 2
}
Input {
 inputs 0
 name keyframe_4
 xpos 282
 ypos -51
 number 3
}
Input {
 inputs 0
 name keyframe_5
 xpos 376
 ypos -51
 number 4
}
push $Npikaframes000
Viewer {
 inputs 1
 frame_range 0-199
 fps 25
 input_number 0
 name Viewer1
 selected true
 xpos 281
 ypos 412
}
end_group
