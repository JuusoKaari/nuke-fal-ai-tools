# Purpose:
# - Nuke Group node that runs fal.ai SAM 3.1 Video (text-prompted video segmentation).
# - Model: fal-ai/sam-3-1/video - https://fal.ai/models/fal-ai/sam-3-1/video
# - One video in, one video out. Text prompt only. Commas can name several objects.
# - No box or point prompts. Downloads the result movie only.
# - Delegates logic to Python runners in `nuke/python/`.

set cut_paste_input [stack 0]
version 11.3 v6
push $cut_paste_input
Group {
 name SAM_3_1_Video_v1
 selected true
 addUserKnob {20 Settings}
 addUserKnob {4 frame_range l "Input frame range" M {root current custom ""}}
 frame_range root
 addUserKnob {1 custom_start l "Custom start"}
 custom_start "1"
 addUserKnob {1 custom_end l "Custom end"}
 custom_end "1"
 addUserKnob {1 prompt l Prompt t "Short noun or comma-separated objects SAM should find (person, cloth). Empty is an error."}
 prompt "person"
 addUserKnob {6 apply_mask l "Apply mask" +STARTLINE}
 apply_mask true
 addUserKnob {7 detection_threshold l "Detection threshold" R 0 1}
 detection_threshold 0.5
 addUserKnob {3 max_objects l "Max objects"}
 max_objects 16
 addUserKnob {4 output_type l "Output type" M {"X264 (.mp4)" "VP9 (.webm)" ""}}
 output_type "X264 (.mp4)"
 addUserKnob {6 show_success_popup l "Show success popup" +STARTLINE}
 show_success_popup true
 addUserKnob {22 execute T "import _nuke_runner_launcher\n_nuke_runner_launcher.execute_this_node()\n" +STARTLINE}
 addUserKnob {20 endGroup n -1}
 addUserKnob {20 Advanced l Advanced +CLOSED}
 addUserKnob {1 python3_cmd l "Python 3 cmd"}
 python3_cmd "py -3"
 addUserKnob {1 FAL}
 FAL "insert fal key to override for this node"
 addUserKnob {22 open_temp_folder l "Open temp folder" T "import nuke_fal_open_folders_v1 as _of\n_of.open_temp_folder()\n" +STARTLINE}
 addUserKnob {22 open_output_folder l "Open output folder" T "import nuke_fal_open_folders_v1 as _of\n_of.open_output_folder()\n"}
 addUserKnob {20 endAdvanced n -1}
 addUserKnob {1 helper_path l "Helper path" +INVISIBLE}
 helper_path "__INSTALL_ROOT__/nuke/python/fal_sam_3_1_video_helper.py"
 addUserKnob {1 runner_path l "Runner path" +INVISIBLE}
 runner_path "__INSTALL_ROOT__/nuke/python/fal_sam_3_1_video_runner_v1.py"
}
Text {
 inputs 0
 message "Connect a video pipe to source_video and press Execute.\nInput frame range controls pre-render range when the input is not a Read with a video file. A Read of an mp4 or mov uploads the whole file.\nSAM 3.1 Video. Text prompt only. Commas can name several objects (person, cloth). Apply mask is on by default. No boxes or points."
 font C:/Windows/Fonts/arial.ttf
 yjustify bottom
 Transform 1
 box {30 30 1906 1052}
 center {560 372}
 name Text1
 xpos 101
 ypos 294
}
set Nfalsam31vid1 [stack 0]
Output {
 name Output1
 xpos 101
 ypos 406
}
Input {
 inputs 0
 name source_video
 xpos 0
 ypos -51
}
push $Nfalsam31vid1
Viewer {
 inputs 1
 frame_range 0-199
 fps 25
 input_number 0
 name Viewer1
 selected true
 xpos 281
 ypos 412
}
end_group
