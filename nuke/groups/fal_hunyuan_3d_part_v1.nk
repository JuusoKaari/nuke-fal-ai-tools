# Purpose:
# - Nuke Group node that runs fal.ai Hunyuan 3D Part Splitter on a local FBX file.
# - Downloads each part FBX and spawns a ReadGeo2 per part.
# - Model: https://fal.ai/models/fal-ai/hunyuan-3d/v3.1/part

set cut_paste_input [stack 0]
version 11.3 v6
push $cut_paste_input
Group {
 name Hunyuan_3D_Part_v1
 selected true
 addUserKnob {20 Settings}
 addUserKnob {2 input_file l "Input FBX" t "FBX only. Max 100MB, face count 30000 or less. Recommended: AIGC-generated models."}
 input_file ""
 addUserKnob {6 show_success_popup l "Show success popup" +STARTLINE}
 show_success_popup true
 addUserKnob {22 execute T "import _nuke_runner_launcher\n_nuke_runner_launcher.execute_this_node()\n" +STARTLINE}
 addUserKnob {20 endGroup n -1}
 addUserKnob {20 Advanced l Advanced +CLOSED}
 addUserKnob {1 python3_cmd l "Python 3 cmd"}
 python3_cmd "py -3"
 addUserKnob {1 FAL}
 FAL "insert fal key to override for this node"
 addUserKnob {22 open_temp_folder l "Open temp folder" T "import nuke_fal_open_folders_v1 as _of\n_of.open_temp_folder()\n" +STARTLINE}
 addUserKnob {22 open_output_folder l "Open output folder" T "import nuke_fal_open_folders_v1 as _of\n_of.open_output_folder()\n"}
 addUserKnob {20 endAdvanced n -1}
 addUserKnob {1 helper_path l "Helper path" +INVISIBLE}
 helper_path "__INSTALL_ROOT__/nuke/python/fal_hunyuan_3d_part_helper.py"
 addUserKnob {1 runner_path l "Runner path" +INVISIBLE}
 runner_path "__INSTALL_ROOT__/nuke/python/fal_hunyuan_3d_part_runner_v1.py"
}
Text {
 inputs 0
 message "Set Input FBX (FBX only, max 100MB, face count 30000 or less) and press Execute.\nRecommended: AIGC-generated meshes such as Hunyuan 3D Image to 3D output.\nDownloads one FBX per part and spawns a ReadGeo2 for each.\nView mesh in 3D Viewer (Viewer mode: 3D); wire ReadGeo into your Scene/ScanlineRender."
 font C:/Windows/Fonts/arial.ttf
 yjustify bottom
 Transform 1
 box {30 30 1906 1052}
 center {560 372}
 name Text1
 xpos 101
 ypos 294
}
set Nhy3dpart001 [stack 0]
Output {
 name Output1
 xpos 101
 ypos 406
}
push $Nhy3dpart001
Viewer {
 inputs 1
 frame_range 0-199
 fps 25
 input_number 0
 name Viewer1
 selected true
 xpos 281
 ypos 412
}
end_group
