  origset true
  name generated_read_06
  label "F: \[value first]-\[value last] \[python \{\}] \nDUR: \[python \{nuke.thisNode()\['last'].value()-nuke.thisNode()\['first'].value()+1\}] \n|\[python \{nuke.thisNode()\['file'].value()\[0].upper()\}]|"
  xpos 2282
  ypos -261
 }
set N85c2e180 [stack 0]
push $N85c2e180
push $N85c2e080
push $N85c2c880
push $N85c2d180
push $N85c2bf80
push $N85c2da80
 ContactSheet {
  inputs 6
  width 3072
  height 1024
  rows 2
  columns 3
  name generated_contactsheet
  xpos 2321
  ypos 173
 }
