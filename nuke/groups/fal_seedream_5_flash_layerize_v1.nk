set Nswitch [stack 0]
 Input {
  inputs 0
  name source_image
  xpos 77
  ypos -667
 }
 NoOp {
  name preview_source_01
  xpos 77
  ypos -292
 }
set Nsrc [stack 0]
push $Nsrc
 Switch {
  inputs 1
  which {{"parent.preview_index - 1"}}
  name ai_input_switch
  xpos 538
  ypos 386
 }
set Nai [stack 0]
push $Nswitch
 Reformat {
  type "to box"
  box_width {{preview_source_01.width}}
  box_height {{preview_source_01.height}}
  box_fixed true
  resize fit
  center false
  disable {{1-parent.match_input_resolution}}
  name generated_output_reformat
  xpos 1642
  ypos 213
 }
set Nreformat [stack 0]
push $Nsheet
push $Nreformat
push $Nai
 Switch {
  inputs 3
  which {{parent.viewer_mode}}
  name viewer_mode_switch
  xpos 858
  ypos 1020
 }
set Nviewer [stack 0]
 Output {
  name Output1
  xpos 858
  ypos 1285
 }
push $Nviewer
