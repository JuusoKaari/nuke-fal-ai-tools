# Purpose:
# - Nuke Group node that runs fal.ai MoGe-3 on a single still.
# - Converts the textured GLB to OBJ, spawns ReadGeo, and spawns a Camera from
#   the returned FOV and intrinsics. Does not build a ScanlineRender setup.
# - Model: https://fal.ai/models/microsoft/moge-3

set cut_paste_input [stack 0]
version 11.3 v6
push $cut_paste_input
Group {
 name MoGe_3_v1
 selected true
 addUserKnob {20 Settings}
 addUserKnob {3 resolution_level l "Resolution level (0-9)"}
 resolution_level 9
 addUserKnob {3 num_refinement_steps l "Refinement steps (0-20)"}
 num_refinement_steps 3
 addUserKnob {1 known_fov_x l "Known horizontal FOV" t "Degrees. Leave empty and MoGe estimates the horizontal FOV."}
 known_fov_x ""
 addUserKnob {6 apply_mask l "Apply mask" +STARTLINE}
 apply_mask true
 addUserKnob {6 show_success_popup l "Show success popup" +STARTLINE}
 show_success_popup true
 addUserKnob {22 execute T "import _nuke_runner_launcher\n_nuke_runner_launcher.execute_this_node()\n" +STARTLINE}
 addUserKnob {20 endGroup n -1}
 addUserKnob {20 Advanced l Advanced +CLOSED}
 addUserKnob {7 edge_threshold l "Edge threshold" R 0 1}
 edge_threshold 0.04
 addUserKnob {1 python3_cmd l "Python 3 cmd"}
 python3_cmd "py -3"
 addUserKnob {1 FAL}
 FAL "insert fal key to override for this node"
 addUserKnob {22 open_temp_folder l "Open temp folder" T "import nuke_fal_open_folders_v1 as _of\n_of.open_temp_folder()\n" +STARTLINE}
 addUserKnob {22 open_output_folder l "Open output folder" T "import nuke_fal_open_folders_v1 as _of\n_of.open_output_folder()\n"}
 addUserKnob {20 endAdvanced n -1}
 addUserKnob {1 helper_path l "Helper path" +INVISIBLE}
 helper_path "__INSTALL_ROOT__/nuke/python/fal_moge_3_helper.py"
 addUserKnob {1 runner_path l "Runner path" +INVISIBLE}
 runner_path "__INSTALL_ROOT__/nuke/python/fal_moge_3_runner_v1.py"
}
Text {
 inputs 0
 message "Connect a still and press Execute.\nMoGe-3 returns a textured mesh in camera space (Y up, looking down -Z).\nExecute converts the GLB to OBJ and spawns ReadGeo plus a Camera.\nFocal length and window translate come from the returned FOV and intrinsics.\nLeave Known horizontal FOV empty to let MoGe estimate the lens.\nDepth, normals, and the point cloud are not imported.\nWire ReadGeo and the Camera into your own Scene and ScanlineRender."
 font C:/Windows/Fonts/arial.ttf
 yjustify bottom
 Transform 1
 box {30 30 1906 1052}
 center {560 372}
 name Text1
 xpos 101
 ypos 294
}
set Nmg3001 [stack 0]
Output {
 name Output1
 xpos 101
 ypos 406
}
Input {
 inputs 0
 name source_image
 xpos 0
 ypos -51
}
push $Nmg3001
Viewer {
 inputs 1
 frame_range 0-199
 fps 25
 input_number 0
 name Viewer1
 selected true
 xpos 281
 ypos 412
}
end_group
