# Purpose:
# - Nuke Group node that pulls a frame-matched foreground matte from a video via fal.ai (LTX 2.5 Alpha Gen).
# - Model: lightricks/ltx-2.5/alpha-gen - https://fal.ai/models/lightricks/ltx-2.5/alpha-gen
# - Output mode Alpha only (default) spawns the grayscale matte. RGBA spawns the
#   ProRes 4444 cutout with straight alpha.
# - Delegates logic to Python runners in `nuke/python/`.

set cut_paste_input [stack 0]
version 11.3 v6
push $cut_paste_input
Group {
 name LTX_25_Alpha_Gen_v1
 selected true
 addUserKnob {20 Settings}
 addUserKnob {4 frame_range l "Input frame range" M {root current custom ""}}
 frame_range root
 addUserKnob {1 custom_start l "Custom start"}
 custom_start "1"
 addUserKnob {1 custom_end l "Custom end"}
 custom_end "1"
 addUserKnob {4 output_mode l "Output mode" M {"Alpha only" RGBA ""}}
 output_mode "Alpha only"
 addUserKnob {6 enable_safety_checker l "Enable safety checker" +STARTLINE}
 enable_safety_checker true
 addUserKnob {6 show_success_popup l "Show success popup" +STARTLINE}
 show_success_popup true
 addUserKnob {22 execute T "import _nuke_runner_launcher\n_nuke_runner_launcher.execute_this_node()\n" +STARTLINE}
 addUserKnob {20 endGroup n -1}
 addUserKnob {20 Advanced l Advanced +CLOSED}
 addUserKnob {1 python3_cmd l "Python 3 cmd"}
 python3_cmd "py -3"
 addUserKnob {1 FAL}
 FAL "insert fal key to override for this node"
 addUserKnob {22 open_temp_folder l "Open temp folder" T "import nuke_fal_open_folders_v1 as _of\n_of.open_temp_folder()\n" +STARTLINE}
 addUserKnob {22 open_output_folder l "Open output folder" T "import nuke_fal_open_folders_v1 as _of\n_of.open_output_folder()\n"}
 addUserKnob {20 endAdvanced n -1}
 addUserKnob {1 helper_path l "Helper path" +INVISIBLE}
 helper_path "__INSTALL_ROOT__/nuke/python/fal_ltx_25_alpha_gen_helper.py"
 addUserKnob {1 runner_path l "Runner path" +INVISIBLE}
 runner_path "__INSTALL_ROOT__/nuke/python/fal_ltx_25_alpha_gen_runner_v1.py"
}
Text {
 inputs 0
 message "Connect a video pipe to source_video and press Execute.\nInput frame range controls pre-render range when the input is not a Read with a video file. A Read of an mp4 or mov uploads the whole file.\nOutput mode Alpha only (default) writes the grayscale matte. RGBA writes the ProRes 4444 cutout with straight alpha. Execute spawns one Read.\nSource video: at most 200 MB and 3072 frames. Long side at most 3840, short side at most 2160, aspect at most 32:9.\nPrice is per second of input, by the shorter side: $0.10 at 1080p, $0.25 at 1440p, $1.00 at 2160p."
 font C:/Windows/Fonts/arial.ttf
 yjustify bottom
 Transform 1
 box {30 30 1906 1052}
 center {560 372}
 name Text1
 xpos 101
 ypos 294
}
set Nfalltx25alphagen [stack 0]
Output {
 name Output1
 xpos 101
 ypos 406
}
Input {
 inputs 0
 name source_video
 xpos 0
 ypos -51
}
push $Nfalltx25alphagen
Viewer {
 inputs 1
 frame_range 0-199
 fps 25
 input_number 0
 name Viewer1
 selected true
 xpos 281
 ypos 412
}
end_group
