# Purpose:
# - Nuke Group node that estimates per-frame depth for a video via fal.ai (Depth Anything Video).
# - Model: fal-ai/depth-anything-video - https://fal.ai/models/fal-ai/depth-anything-video
# - Delegates logic to Python runners in `nuke/python/`.

set cut_paste_input [stack 0]
version 11.3 v6
push $cut_paste_input
Group {
 name Depth_Anything_Video_v1
 selected true
 addUserKnob {20 Settings}
 addUserKnob {4 frame_range l "Input frame range" M {root current custom ""}}
 frame_range root
 addUserKnob {1 custom_start l "Custom start"}
 custom_start "1"
 addUserKnob {1 custom_end l "Custom end"}
 custom_end "1"
 addUserKnob {4 model l "Model size" M {"VDA-Small" "VDA-Base" "VDA-Large" ""}}
 model VDA-Large
 addUserKnob {4 colormap l Colormap M {grayscale turbo inferno magma viridis ""}}
 colormap grayscale
 addUserKnob {4 resolution l Resolution M {auto 360p 480p 720p 1080p ""}}
 resolution auto
 addUserKnob {6 side_by_side l "Side by side" +STARTLINE}
 side_by_side false
 addUserKnob {6 show_success_popup l "Show success popup" +STARTLINE}
 show_success_popup true
 addUserKnob {22 execute T "import _nuke_runner_launcher\n_nuke_runner_launcher.execute_this_node()\n" +STARTLINE}
 addUserKnob {20 endGroup n -1}
 addUserKnob {20 Advanced l Advanced +CLOSED}
 addUserKnob {1 python3_cmd l "Python 3 cmd"}
 python3_cmd "py -3"
 addUserKnob {1 FAL}
 FAL "insert fal key to override for this node"
 addUserKnob {22 open_temp_folder l "Open temp folder" T "import nuke_fal_open_folders_v1 as _of\n_of.open_temp_folder()\n" +STARTLINE}
 addUserKnob {22 open_output_folder l "Open output folder" T "import nuke_fal_open_folders_v1 as _of\n_of.open_output_folder()\n"}
 addUserKnob {20 endAdvanced n -1}
 addUserKnob {1 helper_path l "Helper path" +INVISIBLE}
 helper_path "__INSTALL_ROOT__/nuke/python/fal_depth_anything_video_helper.py"
 addUserKnob {1 runner_path l "Runner path" +INVISIBLE}
 runner_path "__INSTALL_ROOT__/nuke/python/fal_depth_anything_video_runner_v1.py"
}
Text {
 inputs 0
 message "Connect a video pipe to source_video and press Execute.\nInput frame range controls pre-render range when the input is not a Read with a video file. A Read of an mp4 or mov uploads the whole file.\nDepth Anything Video. $0.04 per second of video, at most 2400 frames. Grayscale is normalized depth. Other colormaps are color previews. Side by side puts the plate next to the depth."
 font C:/Windows/Fonts/arial.ttf
 yjustify bottom
 Transform 1
 box {30 30 1906 1052}
 center {560 372}
 name Text1
 xpos 101
 ypos 294
}
set Nfaldepvid1 [stack 0]
Output {
 name Output1
 xpos 101
 ypos 406
}
Input {
 inputs 0
 name source_video
 xpos 0
 ypos -51
}
push $Nfaldepvid1
Viewer {
 inputs 1
 frame_range 0-199
 fps 25
 input_number 0
 name Viewer1
 selected true
 xpos 281
 ypos 412
}
end_group
