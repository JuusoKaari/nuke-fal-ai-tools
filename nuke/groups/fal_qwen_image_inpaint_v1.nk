# Purpose:
# - Nuke Group node that runs fal.ai Qwen Image Edit inpainting with in-group output preview.
# - Model: https://fal.ai/models/fal-ai/qwen-image-edit/inpaint
# - Input 0: source_image (look-through). Input 1: mask (white = region to inpaint). No ROI.
# - Preview graph is baked (look-through + generated reads + viewer_mode_switch).
# - Hidden fal_tool_id identifies the tool type; display name may be v1, v2, v3, etc.
# - Keeps the .nk execute script small by delegating logic to a Python runner in `nuke/python/`.

set cut_paste_input [stack 0]
version 11.3 v6
push $cut_paste_input
Group {
 inputs 2
 name Qwen_Image_Edit_Inpaint_v1
 knobChanged "\nimport nuke_group_output_preview_v1 as _gop\n_gop.on_knob_changed_ui()\n"
 selected true
 addUserKnob {20 Settings}
 addUserKnob {1 prompt l Prompt}
 prompt "Describe what should appear inside the masked region"
 addUserKnob {1 negative_prompt l "Negative prompt"}
 negative_prompt ""
 addUserKnob {4 output_format l "Output format" M {png jpeg ""}}
 output_format png
 addUserKnob {1 num_images l "Num images (1-4)"}
 num_images "1"
 addUserKnob {1 num_inference_steps l Steps}
 num_inference_steps "30"
 addUserKnob {1 guidance_scale l "Guidance scale"}
 guidance_scale "4"
 addUserKnob {1 strength l Strength}
 strength "0.93"
 addUserKnob {4 acceleration l Acceleration M {none regular high}}
 acceleration regular
 addUserKnob {6 enable_safety_checker l "Enable safety checker" +STARTLINE}
 enable_safety_checker true
 addUserKnob {6 show_success_popup l "Show success popup" +STARTLINE}
 show_success_popup true
 addUserKnob {1 seed l "Seed (optional)"}
 seed ""
 addUserKnob {1 image_size l "Image size (optional)"}
 image_size ""
 addUserKnob {26 preview_separator l "" +STARTLINE}
 addUserKnob {4 viewer_mode l "Viewer mode" M {Input Generated "Generated grid" ""}}
 viewer_mode Input
 addUserKnob {7 preview_index l "preview index" R 1 2.999}
 preview_index 1
 addUserKnob {6 spawn_reads_in_graph l "Spawn reads in graph" +STARTLINE}
 spawn_reads_in_graph false
 addUserKnob {6 match_input_resolution l "Match input resolution" +STARTLINE}
 match_input_resolution true
 addUserKnob {6 has_generated_output -STARTLINE +DISABLED +INVISIBLE}
 has_generated_output false
 addUserKnob {26 generated_output_count l "Generated outputs:" T "0"}
 addUserKnob {1 generated_output_paths l "generated output paths" +INVISIBLE}
 generated_output_paths ""
 addUserKnob {22 extract_selected_generation l "Extract selected as Read" T "import nuke_group_output_preview_v1 as _gop\n_gop.extract_selected_generation_ui()\n" +STARTLINE}
 addUserKnob {22 clear_generated_outputs l "Clear generation history" T "import nuke_group_output_preview_v1 as _gop\n_gop.clear_generated_outputs_ui()\n"}
 addUserKnob {22 execute T "import _nuke_runner_launcher\n_nuke_runner_launcher.execute_this_node()\n" +STARTLINE}
 addUserKnob {20 endGroup n -1}
 addUserKnob {20 Advanced l Advanced +CLOSED}
 addUserKnob {1 python3_cmd l "Python 3 cmd"}
 python3_cmd "py -3"
 addUserKnob {1 FAL}
 FAL "insert fal key to override for this node"
 addUserKnob {20 endAdvanced n -1}
 addUserKnob {1 helper_path l "Helper path" +INVISIBLE}
 helper_path "__INSTALL_ROOT__/nuke/python/fal_qwen_image_inpaint_helper.py"
 addUserKnob {1 runner_path l "Runner path" +INVISIBLE}
 runner_path "__INSTALL_ROOT__/nuke/python/fal_qwen_image_inpaint_runner_v1.py"
 addUserKnob {1 fal_tool_id l "fal tool id" +INVISIBLE}
 fal_tool_id Qwen_Image_Edit_Inpaint_v1
}
 Read {
  inputs 0
  file_type png
  file ""
  format "1408 768 0 0 1408 768 1 "
  origset true
  name generated_read_01
  label "F: \[value first]-\[value last] \[python \{\}] \nDUR: \[python \{nuke.thisNode()\['last'].value()-nuke.thisNode()\['first'].value()+1\}] \n|\[python \{nuke.thisNode()\['file'].value()\[0].upper()\}]|"
  xpos 1732
  ypos -261
 }
set N85c2da80 [stack 0]
 Read {
  inputs 0
  file_type png
  file ""
  format "1408 768 0 0 1408 768 1 "
  origset true
  name generated_read_02
  label "F: \[value first]-\[value last] \[python \{\}] \nDUR: \[python \{nuke.thisNode()\['last'].value()-nuke.thisNode()\['first'].value()+1\}] \n|\[python \{nuke.thisNode()\['file'].value()\[0].upper()\}]|"
  xpos 1842
  ypos -261
 }
set N85c2bf80 [stack 0]
 Read {
  inputs 0
  file_type png
  file ""
  format "1408 768 0 0 1408 768 1 "
  origset true
  name generated_read_03
  label "F: \[value first]-\[value last] \[python \{\}] \nDUR: \[python \{nuke.thisNode()\['last'].value()-nuke.thisNode()\['first'].value()+1\}] \n|\[python \{nuke.thisNode()\['file'].value()\[0].upper()\}]|"
  xpos 1952
  ypos -261
 }
set N85c2d180 [stack 0]
 Read {
  inputs 0
  file_type png
  file ""
  format "1408 768 0 0 1408 768 1 "
  origset true
  name generated_read_04
  label "F: \[value first]-\[value last] \[python \{\}] \nDUR: \[python \{nuke.thisNode()\['last'].value()-nuke.thisNode()\['first'].value()+1\}] \n|\[python \{nuke.thisNode()\['file'].value()\[0].upper()\}]|"
  xpos 2062
  ypos -261
 }
set N85c2c880 [stack 0]
push $N85c2c880
push $N85c2d180
push $N85c2bf80
push $N85c2da80
 ContactSheet {
  inputs 4
  width 2048
  height 1024
  rows 2
  columns 2
  name generated_contactsheet
  xpos 2101
  ypos 173
 }
set Ndb7c100 [stack 0]
push $N85c2c880
push $N85c2d180
push $N85c2bf80
push $N85c2da80
 Switch {
  inputs 4
  which {{"parent.preview_index - 1"}}
  name generated_switch
  xpos 1642
  ypos 183
 }
set Ndb7c200 [stack 0]
 Input {
  inputs 0
  name source_image
  xpos 77
  ypos -667
 }
 NoOp {
  name preview_source_01
  xpos 77
  ypos -292
 }
set N16c9200 [stack 0]
push $N16c9200
 Switch {
  inputs 1
  which {{"parent.preview_index - 1"}}
  name ai_input_switch
  xpos 538
  ypos 386
 }
set Ndb7c300 [stack 0]
push $Ndb7c200
 Reformat {
  type "to box"
  box_width {{preview_source_01.width}}
  box_height {{preview_source_01.height}}
  box_fixed true
  resize fit
  center false
  disable {{1-parent.match_input_resolution}}
  name generated_output_reformat
  xpos 1642
  ypos 213
 }
set Ndb7c210 [stack 0]
push $Ndb7c100
push $Ndb7c210
push $Ndb7c300
 Switch {
  inputs 3
  which {{parent.viewer_mode}}
  name viewer_mode_switch
  xpos 858
  ypos 1020
 }
set Nf9827200 [stack 0]
 Output {
  name Output1
  xpos 858
  ypos 1285
 }
 Input {
  inputs 0
  name mask
  xpos 188
  ypos -667
  number 1
 }
push $Nf9827200
 Viewer {
  inputs 1
  frame_range 0-199
  fps 25
  input_number 0
  name Viewer1
  xpos -646
  ypos 1786
 }
end_group
